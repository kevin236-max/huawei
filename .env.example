# 选择模型后端：openai（本地 vLLM 等 OpenAI 兼容服务）或 novita
LLM_BACKEND=openai

# openai：OpenAI Chat Completions 兼容协议，不会自动连接 OpenAI 官方地址
OPENAI_BASE_URL=http://127.0.0.1:18000/v1
OPENAI_API_KEY=EMPTY
OPENAI_MODEL=Qwen3.8-27B
OPENAI_REASONING_EFFORT=off

# novita：Novita AI 的 OpenAI 兼容接口，请求发往 BASE_URL + /chat/completions
NOVITA_BASE_URL=https://api.novita.ai/openai/v1
NOVITA_API_KEY=
NOVITA_MODEL=
NOVITA_REASONING_EFFORT=off
